    version: 2
    renderer: NetworkManager              # Tells Netplan to let NetworkManager manage the hardware
    wifis:
      wlan0:                              # The installer maps this to standard physical Wi-Fi cards
        dhcp4: true                       # Obtains addresses dynamically via DHCP
        access-points:
          "Harmony-Student-Crash":
            password: "$6$hK4mnophcuGlIp44$ARIxh5NyB./XbpK/uX7FlBdETPde1efUpNcpiMiQVgNsE0Tx6wWazvb9nAv106hg2gVQv5pKV6y/deL7A729n/"

  late-commands:
    # 1. Configure GDM3 Desktop Auto-Login
    - |
      MY_USER=$(awk -F: '$3 == 1000 {print $1}' /target/etc/passwd)
      echo "[daemon]" > /target/etc/gdm3/custom.conf
      echo "AutomaticLoginEnable=True" >> /target/etc/gdm3/custom.conf
      echo "AutomaticLogin=$MY_USER" >> /target/etc/gdm3/custom.conf

    # 2. Set unique hostname based on serial number or primary MAC address
    - |
      SERIAL=$(cat /sys/class/dmi/id/product_serial | tr -d ' ' | tr 'A-Z' 'a-z')
      if [ -z "$SERIAL" ] || [ "$SERIAL" = "notassigned" ] || [ "$SERIAL" = "0000000000" ]; then
        FIRST_IFACE=$(ls /sys/class/net | grep -E '^(en|wl|eth)' | head -n 1)
        SERIAL=$(cat /sys/class/net/$FIRST_IFACE/address | tr -d ':')
      fi
      echo "laptop-$SERIAL" > /target/etc/hostname
      sed -i "s/ubuntu-desktop/laptop-$SERIAL/g" /target/etc/hosts

    - |
      sudo wget -P /tmp https://github.com/soundshow-app/soundshow-downloads/releases/download/v2026.05.06/SoundShow-linux-x64.zip
      sudo unzip /tmp/SoundShow-linux-x64.zip -d /opt
      sudo chmod +x /opt/SoundShow/SoundShow.x86_64
      sudo wget -P /usr/share/icons/ https://images.seeklogo.com/logo-png/65/1/canva-logo-png_seeklogo-653227.png
      sudo wget -P /usr/share/icons/ https://raw.githubusercontent.com/iluvpidgeons/AutoinstallUbuntu/refs/heads/main/SoundShow.png
      sudo bash -c 'cat > /usr/share/applications/canva.desktop <<EOF
      [Desktop Entry]
      Version=1.0
      Type=Application
      Name=Canva
      Comment=Open Canva in Firefox
      Exec=firefox --kiosk https://www.canva.com/
      Icon=/usr/share/icons/canva-logo-png_seeklogo-653227.png
      Terminal=false
      Categories=Office;
      EOF'
      sudo bash -c 'cat > /usr/share/applications/soundshow.desktop <<EOF
      [Desktop Entry]
      Version=1.0
      Type=Application
      Name=SoundShow
      Comment=Open SoundShow
      Exec=/opt/SoundShow/SoundShow.x86_64
      Icon=/usr/share/icons/SoundShow.png
      Terminal=false
      Categories=Audio;
      EOF'
      sudo chmod +x /usr/share/applications/canva.desktop
      sudo chmod +x /usr/share/applications/soundshow.desktop
      gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
      gsettings set org.gnome.desktop.interface clock-format '12h'
      gsettings set org.gnome.shell.extensions.dash-to-dock dock-position BOTTOM
      gsettings set org.gnome.shell.extensions.dash-to-dock dock-fixed false
      gsettings set org.gnome.shell favorite-apps \
      "[
        'firefox_firefox.desktop',
        'org.gnome.Nautilus.desktop',
        'org.gnome.Ptyxis.desktop',
        'gimp_gimp.desktop',
        'audacity_audacity.desktop',
        'soundshow.desktop',
        'canva.desktop'
      ]"