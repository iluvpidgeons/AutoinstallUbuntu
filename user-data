  identity:
    hostname: ubuntu-desktop
    username: wesstudent
    password: "$6$xBSscV177hptiTup$gdeEBiH2QEJiw2ArAO3AiC0aD4JI7L9ub/ohW1SCxbE2sZ3KPbQZ75gbClYaRBB/rNoI4BiZXpzEnoy3xR32b1"
  
